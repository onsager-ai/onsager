# Per-slot edge proxy.
#
# Variables come from the slot's .env.slot (sourced by docker-compose):
#   EDGE_PORT          — port Caddy listens on
#
# Routing model — same-origin for everything the browser hits:
#   /api/*          → portal:3002   (ADR 0006 — portal owns all /api/*)
#   /mcp/*          → portal:3002   (ADR 0007 — MCP server for AI clients)
#   /*              → dashboard:5173 (Vite dev server, with HMR upgrade)
#
# Caddy upgrades any WebSocket request transparently — no per-route
# `@websocket matcher` block is needed for the dashboard's HMR. The
# order of `handle` blocks is significant: more specific paths come
# first.
{
	# Run as a single, ephemeral container — disable the admin endpoint so
	# the slot doesn't open another port we'd have to track.
	admin off
	# Don't try to provision certs; we serve plain HTTP behind SSH-forward.
	auto_https off
	persist_config off
}

:{$EDGE_PORT} {
	log {
		output stdout
		format console
		level INFO
	}

	# Portal owns all /api/* routes (ADR 0006).
	handle /api/* {
		reverse_proxy portal:3002
	}

	# MCP server (ADR 0007 / #288) — runtime-agnostic public contract
	# for AI clients. Same upstream as /api/* (portal owns clause 1 of
	# the seam rule).
	handle /mcp/* {
		reverse_proxy portal:3002
	}

	# Everything else → the Vite dev server. Vite handles its own HMR
	# WebSocket on the same port; Caddy upgrades transparently.
	handle {
		reverse_proxy dashboard:5173
	}
}
