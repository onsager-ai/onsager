# Onsager v2 dev environment. Copy to .env and adjust:  cp .env.example .env
# `just dev` derives DATABASE_URL from the compose db automatically;
# set it here only for bare-binary runs.

# DATABASE_URL=postgres://onsager:onsager@localhost:5432/onsager

# 32-byte hex AES-256-GCM key sealing workspace credentials at rest.
# Generate once: openssl rand -hex 32
# ONSAGER_CREDENTIAL_KEY=

# Listen address (default 127.0.0.1:3002).
# ONSAGER_BIND=127.0.0.1:3002

# Max concurrent agent sessions (ADR 0030; default 4, floored at 1).
# ONSAGER_MAX_CONCURRENT_RUNS=4

# Fleet (ADR 0030). On the control plane: shared secret machines present to
# dial in; unset → /api/fleet/connect fails closed (single-process).
# ONSAGER_MACHINE_TOKEN=
# On a worker (`onsager worker`): where to dial + how to identify.
# ONSAGER_CONTROL_URL=ws://127.0.0.1:3002
# ONSAGER_MACHINE_NAME=local

# Public https origin in deployed environments (Secure cookies).
# ONSAGER_PUBLIC_URL=

# Vite binds all interfaces for remote-dev boxes.
# VITE_HOST=0.0.0.0

# One-shot destructive schema reset (#637): set to "true" to DROP and
# recreate the public schema at boot before migrating. Use to bring v2
# up over a database that still carries an older schema; REMOVE after
# the deploy. Off by default.
# ONSAGER_RESET_SCHEMA=true
