# Onsager v2 dev environment. Copy to .env and adjust:  cp .env.example .env
# `just dev` derives DATABASE_URL from the compose db automatically;
# set it here only for bare-binary runs.

# DATABASE_URL=postgres://onsager:onsager@localhost:5432/onsager

# 32-byte hex AES-256-GCM key sealing workspace credentials at rest.
# Generate once: openssl rand -hex 32
# ONSAGER_CREDENTIAL_KEY=

# Listen address (default 127.0.0.1:3002).
# ONSAGER_BIND=127.0.0.1:3002

# Public https origin in deployed environments (Secure cookies).
# ONSAGER_PUBLIC_URL=

# Vite binds all interfaces for remote-dev boxes.
# VITE_HOST=0.0.0.0
